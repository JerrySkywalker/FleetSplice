{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FleetSplice",
  "version": "0.1.0",
  "identifier": "io.fleetsplice.desktop",
  "build": { "beforeBuildCommand": "npm run desktop:build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "FleetSplice Agent Manager", "width": 960, "height": 680, "minWidth": 640, "minHeight": 480 }], "security": { "capabilities": ["agent-manager"] } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["../package-resources"]
  }
}

{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "jsx": "react-jsx", "skipLibCheck": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "types": ["node"], "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
